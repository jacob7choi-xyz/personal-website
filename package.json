{
  "name": "jacob-choi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "audit:check": "node scripts/audit-check.mjs",
    "audit:test": "node scripts/audit-check.test.mjs",
    "test:annotations": "tsx src/lib/annotated-text.test.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:annotations && npm run validate:content && npm run audit:test && npm run build && npm run audit:check"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.35.1",
    "next": "^15.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^25",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^8",
    "eslint-config-next": "^15.5.22",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
