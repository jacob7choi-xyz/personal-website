{
  "name": "jacob-choi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "audit:check": "node scripts/audit-check.mjs",
    "audit:test": "node scripts/audit-check.test.mjs",
    "check:render": "node scripts/check-render.mjs",
    "test:annotations": "tsx src/lib/annotated-text.test.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:annotations && npm run validate:content && npm run verify:provenance && npm run verify:signature && npm run audit:test && npm run build && npm run check:render && npm run audit:check",
    "verify:signature": "node scripts/generate-signature.cjs --check",
    "verify:provenance": "node scripts/verify-provenance.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^14.1.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "opentype.js": "2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
