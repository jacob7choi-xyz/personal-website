{
  "name": "jacob-choi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "audit:check": "node scripts/audit-check.mjs",
    "audit:test": "node scripts/audit-check.test.mjs",
    "test:annotations": "tsx src/lib/annotated-text.test.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:annotations && npm run validate:content && npm run verify:provenance && npm run verify:signature && npm run audit:test && npm run build && npm run audit:check",
    "verify:signature": "node scripts/generate-signature.cjs --check",
    "verify:provenance": "node scripts/verify-provenance.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.42.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "opentype.js": "2.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
